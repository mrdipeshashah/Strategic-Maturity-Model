WITH cleaned_data AS (
  SELECT DISTINCT
    customer_id,
    COALESCE(profit, 0) AS profit
  FROM `mrdipeshashah.customersalesdata.ecommerce`
  WHERE customer_id IS NOT NULL
),
customer_profit AS (
  SELECT
    customer_id,
    SUM(profit) AS net_customer_profit
  FROM cleaned_data
  GROUP BY customer_id
)
SELECT
  CASE
    WHEN net_customer_profit <= 0 THEN 'Negative / Unprofitable'
    WHEN net_customer_profit BETWEEN 0.01 AND 100 THEN 'Low Value (£0-£100)'
    WHEN net_customer_profit BETWEEN 100.01 AND 500 THEN 'Mid Value (£100-£500)'
    ELSE 'High Value (£500+)'
  END AS profit_bucket,
  COUNT(customer_id) AS customer_count,
  SUM(net_customer_profit) AS total_bucket_profit
FROM customer_profit
GROUP BY 1;
