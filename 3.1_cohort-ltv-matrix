WITH cohort_orders AS (
  SELECT
    customer_id,
    DATE_TRUNC(first_order_date, MONTH) AS cohort_month,
    DATE_DIFF(DATE_TRUNC(order_date, MONTH), DATE_TRUNC(first_order_date, MONTH), MONTH) AS cohort_age_months,
    revenue,
    profit
  FROM `enter.tablename.view_order_grain_master`
),
cohort_sizes AS (
  SELECT
    cohort_month,
    COUNT(DISTINCT customer_id) AS total_cohort_customers
  FROM cohort_orders
  GROUP BY cohort_month
),
monthly_cohort_totals AS (
  SELECT
    cohort_month,
    cohort_age_months,
    SUM(revenue) AS monthly_revenue,
    SUM(profit) AS monthly_profit
  FROM cohort_orders
  GROUP BY cohort_month, cohort_age_months
)
SELECT
  m.cohort_month,
  m.cohort_age_months,
  s.total_cohort_customers,
  m.monthly_revenue,
  m.monthly_profit,
  SUM(m.monthly_revenue) OVER(PARTITION BY m.cohort_month ORDER BY m.cohort_age_months ASC) AS cumulative_revenue,
  SUM(m.monthly_profit) OVER(PARTITION BY m.cohort_month ORDER BY m.cohort_age_months ASC) AS cumulative_profit,
  ROUND(SUM(m.monthly_revenue) OVER(PARTITION BY m.cohort_month ORDER BY m.cohort_age_months ASC) / s.total_cohort_customers, 2) AS ltv_revenue_per_customer,
  ROUND(SUM(m.monthly_profit) OVER(PARTITION BY m.cohort_month ORDER BY m.cohort_age_months ASC) / s.total_cohort_customers, 2) AS ltv_profit_per_customer
FROM monthly_cohort_totals m
JOIN cohort_sizes s ON m.cohort_month = s.cohort_month;
