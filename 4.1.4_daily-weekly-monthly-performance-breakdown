SELECT
  DATE_TRUNC(order_date, MONTH) AS performance_month,
  EXTRACT(YEAR FROM order_date) AS performance_year,
  COUNT(DISTINCT customer_id) AS total_unique_buyers,
  COUNT(1) AS total_orders,
  ROUND(SUM(revenue), 2) AS gross_revenue,
  ROUND(SUM(profit), 2) AS net_profit,
  ROUND(SUM(revenue) / COUNT(1), 2) AS overall_aov
FROM `enter.tablename.view_order_grain_master`
GROUP BY 1, 2
ORDER BY performance_month ASC;
