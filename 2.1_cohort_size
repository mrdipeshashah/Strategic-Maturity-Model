WITH cleaned_data AS (
  SELECT DISTINCT
    customer_id,
    CAST(order_date AS DATE) AS order_date,
    COALESCE(revenue, 0) AS revenue,
    COALESCE(profit, 0) AS profit
  FROM `enter.tablename_123456.events_*`
  WHERE customer_id IS NOT NULL 
    AND order_date IS NOT NULL
),
customer_cohorts AS (
  SELECT
    customer_id,
    order_date,
    revenue,
    profit,
    DATE_TRUNC(MIN(order_date) OVER(PARTITION BY customer_id), MONTH) AS cohort_month
  FROM cleaned_data
)
SELECT
  cohort_month,
  COUNT(DISTINCT customer_id) AS total_cohort_customers,
  SUM(revenue) AS total_cohort_revenue,
  SUM(profit) AS total_cohort_profit
FROM customer_cohorts
GROUP BY cohort_month;
