WITH ordered_purchases AS (
  SELECT
    customer_id,
    order_date,
    ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY order_date ASC) AS order_seq
  FROM `mrdipeshashah.customersalesdata.view_order_grain_master`
),

first_second_gaps AS (
  SELECT
    p1.customer_id,
    p1.order_date AS first_order_date,
    p2.order_date AS second_order_date,
    DATE_DIFF(p2.order_date, p1.order_date, DAY) AS days_to_second_order
  FROM ordered_purchases p1
  JOIN ordered_purchases p2 ON p1.customer_id = p2.customer_id AND p2.order_seq = 2
  WHERE p1.order_seq = 1
)

SELECT
  CASE
    WHEN days_to_second_order <= 30 THEN '01. 0-30 Days'
    WHEN days_to_second_order <= 60 THEN '02. 31-60 Days'
    WHEN days_to_second_order <= 90 THEN '03. 61-90 Days'
    WHEN days_to_second_order <= 180 THEN '04. 91-180 Days'
    WHEN days_to_second_order <= 365 THEN '05. 181-365 Days'
    ELSE '06. 365+ Days'
  END AS repurchase_window_bucket,
  COUNT(customer_id) AS total_customers,
  ROUND(AVG(days_to_second_order), 1) AS avg_days_in_bucket
FROM first_second_gaps
GROUP BY 1
ORDER BY repurchase_window_bucket ASC;
