WITH customer_cohorts AS (
  SELECT
    customer_id,
    EXTRACT(YEAR FROM MIN(order_date)) AS cohort_year
  FROM `enter.tablename.view_order_grain_master`
  GROUP BY 1
)

SELECT
  EXTRACT(YEAR FROM t.order_date) AS calendar_year,
  c.cohort_year,
  CASE 
    WHEN EXTRACT(YEAR FROM t.order_date) = c.cohort_year THEN 'New Acquisition'
    ELSE 'Late Money (Repeat)'
  END AS revenue_type,
  COUNT(DISTINCT t.customer_id) AS active_customers,
  ROUND(SUM(t.revenue), 2) AS total_revenue,
  ROUND(SUM(t.profit), 2) AS total_profit
FROM `enter.tablename.view_order_grain_master` t
JOIN customer_cohorts c ON t.customer_id = c.customer_id
GROUP BY 1, 2, 3
ORDER BY calendar_year ASC, cohort_year ASC;
