WITH customer_lifespan AS (
  SELECT
    customer_id,
    order_date,
    first_order_date,
    revenue,
    profit,
    DATE_DIFF(DATE_TRUNC(order_date, MONTH), DATE_TRUNC(first_order_date, MONTH), MONTH) AS age_month
  FROM `mrdipeshashah.customersalesdata.view_order_grain_master`
),
total_unique_customers AS (
  SELECT COUNT(DISTINCT customer_id) AS grand_total_customers
  FROM `mrdipeshashah.customersalesdata.view_order_grain_master`
),
milestone_totals AS (
  SELECT
    c.age_month,
    SUM(c.revenue) AS monthly_revenue,
    SUM(c.profit) AS monthly_profit
  FROM customer_lifespan c
  GROUP BY c.age_month
)
SELECT
  m.age_month AS cohort_age_months,
  SUM(m.monthly_revenue) OVER(ORDER BY m.age_month ASC) AS total_cumulative_revenue,
  SUM(m.monthly_profit) OVER(ORDER BY m.age_month ASC) AS total_cumulative_profit,
  ROUND(SUM(m.monthly_revenue) OVER(ORDER BY m.age_month ASC) / t.grand_total_customers, 2) AS avg_cumulative_ltv_revenue,
  ROUND(SUM(m.monthly_profit) OVER(ORDER BY m.age_month ASC) / t.grand_total_customers, 2) AS avg_cumulative_ltv_profit
FROM milestone_totals m
CROSS JOIN total_unique_customers t
WHERE m.age_month <= 24;
