WITH customer_journey AS (
  SELECT
    customer_id,
    order_date,
    revenue,
    profit,
    EXTRACT(YEAR FROM MIN(order_date) OVER(PARTITION BY customer_id)) AS cohort_year,
    ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY order_date ASC) AS order_seq
  FROM `mrdipeshashah.customersalesdata.view_order_grain_master`
),

cohort_summary AS (
  SELECT
    cohort_year,
    COUNT(DISTINCT CASE WHEN order_seq = 1 THEN customer_id END) AS total_acquired_customers,
    COUNT(DISTINCT CASE WHEN order_seq = 2 THEN customer_id END) AS converted_second_order_customers,
    SUM(CASE WHEN order_seq = 1 THEN revenue ELSE 0 END) AS order_1_revenue,
    SUM(CASE WHEN order_seq = 2 THEN revenue ELSE 0 END) AS order_2_revenue,
    SUM(CASE WHEN order_seq = 1 THEN profit ELSE 0 END) AS order_1_profit,
    SUM(CASE WHEN order_seq = 2 THEN profit ELSE 0 END) AS order_2_profit
  FROM customer_journey
  GROUP BY 1
)

SELECT
  cohort_year,
  total_acquired_customers,
  converted_second_order_customers,
  ROUND((converted_second_order_customers / NULLIF(total_acquired_customers, 0)) * 100, 1) AS second_order_conversion_pct,
  ROUND(order_1_revenue, 0) AS total_order_1_revenue,
  ROUND(order_2_revenue, 0) AS total_order_2_revenue,
  ROUND(order_1_profit + order_2_profit, 0) AS combined_bridge_profit
FROM cohort_summary
ORDER BY cohort_year ASC;
