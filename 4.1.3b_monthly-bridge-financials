WITH sequenced_orders AS (
  SELECT
    customer_id,
    order_date,
    revenue,
    profit,
    ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY order_date ASC) AS order_seq
  FROM `enter.tablename.view_order_grain_master`
)

SELECT
  DATE_TRUNC(order_date, MONTH) AS transaction_month,
  COUNT(DISTINCT CASE WHEN order_seq = 1 THEN customer_id END) AS new_customers_acquired,
  COUNT(DISTINCT CASE WHEN order_seq = 2 THEN customer_id END) AS repeat_customers_converted,
  ROUND(SUM(CASE WHEN order_seq = 1 THEN revenue ELSE 0 END), 2) AS order_1_revenue,
  ROUND(SUM(CASE WHEN order_seq = 2 THEN revenue ELSE 0 END), 2) AS order_2_revenue,
  ROUND(SUM(CASE WHEN order_seq = 2 THEN profit ELSE 0 END), 2) AS order_2_profit
FROM sequenced_orders
GROUP BY 1
ORDER BY transaction_month ASC;
