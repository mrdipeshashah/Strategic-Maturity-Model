WITH cohort_sizes AS (
  SELECT
    DATE_TRUNC(first_order_date, MONTH) AS cohort_month,
    COUNT(DISTINCT customer_id) AS cohort_start_size
  FROM `enter.tablename..view_order_grain_master`
  GROUP BY cohort_month
),
active_customers_by_month AS (
  SELECT
    DATE_TRUNC(first_order_date, MONTH) AS cohort_month,
    DATE_DIFF(DATE_TRUNC(order_date, MONTH), DATE_TRUNC(first_order_date, MONTH), MONTH) AS cohort_age_months,
    COUNT(DISTINCT customer_id) AS active_customers
  FROM `enter.tablename..view_order_grain_master`
  GROUP BY cohort_month, cohort_age_months
)
SELECT
  a.cohort_month,
  a.cohort_age_months,
  s.cohort_start_size,
  a.active_customers,
  ROUND(a.active_customers / s.cohort_start_size, 4) AS retention_rate
FROM active_customers_by_month a
JOIN cohort_sizes s ON a.cohort_month = s.cohort_month;
