WITH ordered_purchases AS (
  SELECT 
    customer_id,
    order_date,
    ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY order_date) AS order_sequence,
    LAG(order_date) OVER (PARTITION BY customer_id ORDER BY order_date) AS previous_order_date
  FROM `enter.tablename.view_order_grain_master`
)
SELECT 
  CONCAT('Order ', order_sequence - 1, ' to ', order_sequence) AS purchase_interval,
  COUNT(DISTINCT customer_id) AS total_repeat_orders,
  ROUND(AVG(DATE_DIFF(order_date, previous_order_date, DAY)), 1) AS avg_days_between_orders,
  APPROX_QUANTILES(DATE_DIFF(order_date, previous_order_date, DAY), 100)[OFFSET(50)] AS median_days_between_orders
FROM ordered_purchases
WHERE previous_order_date IS NOT NULL
GROUP BY order_sequence
HAVING order_sequence <= 5
ORDER BY order_sequence ASC;
