WITH deduplicated_orders AS (
  SELECT DISTINCT
    customer_id,
    CAST(order_date AS DATE) AS order_date,
    COALESCE(revenue, 0) AS revenue,
    COALESCE(profit, 0) AS profit
  FROM ‘enter.tablename.view_raw_transactional_customer_ordertable’
  WHERE customer_id IS NOT NULL 
    AND order_date IS NOT NULL
),

sequenced_orders AS (
  SELECT
    customer_id,
    order_date,
    revenue,
    profit,
    MIN(order_date) OVER(PARTITION BY customer_id) AS first_order_date,
    ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY order_date ASC) AS order_sequence,
    LAG(order_date) OVER(PARTITION BY customer_id ORDER BY order_date ASC) AS prior_order_date
  FROM deduplicated_orders
)

SELECT
  customer_id,
  order_date,
  revenue,
  profit,
  first_order_date,
  DATE_TRUNC(first_order_date, MONTH) AS cohort_month,
  DATE_TRUNC(order_date, MONTH) AS order_month,
  order_sequence,
  CASE 
    WHEN order_sequence = 2 THEN DATE_DIFF(order_date, first_order_date, DAY)
    ELSE 0 
  END AS days_to_next_order,
  profit AS gross_margin,
  SUM(revenue) OVER(PARTITION BY customer_id ORDER BY order_date ASC) AS cumulative_customer_revenue,
  IF(order_sequence = 2, 1, 0) AS is_bridge_crossed,
  SUM(profit) OVER(PARTITION BY customer_id ORDER BY order_date ASC) AS realized_ltv_profit,
  CASE 
    WHEN order_sequence = 2 THEN profit 
    ELSE 0 
  END AS moat_score_contribution,
  CASE 
    WHEN order_sequence > 1 THEN DATE_DIFF(order_date, prior_order_date, DAY)
    ELSE 0 
  END AS days_between_orders
FROM sequenced_orders;
