WITH customer_orders AS (
  SELECT
    customer_id,
    revenue,
    profit,
    ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY order_date ASC) AS order_seq
  FROM `mrdipeshashah.customersalesdata.view_order_grain_master`
)

SELECT
  CASE 
    WHEN order_seq = 1 THEN 'Order 1 (Acquisition)'
    WHEN order_seq = 2 THEN 'Order 2 (First Repeat)'
    ELSE 'Order 3+ (Loyalty)'
  END AS order_stage,
  COUNT(DISTINCT customer_id) AS total_customers,
  COUNT(1) AS total_orders,
  ROUND(SUM(revenue), 2) AS total_revenue,
  ROUND(SUM(profit), 2) AS total_profit,
  ROUND(AVG(revenue), 2) AS avg_order_value,
  ROUND(AVG(profit), 2) AS avg_profit_per_order
FROM customer_orders
WHERE order_seq <= 3
GROUP BY 1
ORDER BY order_stage ASC;
