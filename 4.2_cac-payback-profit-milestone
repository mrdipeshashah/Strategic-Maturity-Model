WITH first_orders AS (
  -- Step 1: Identify customer acquisition date and initial cohort year
  SELECT
    customer_id,
    MIN(order_date) AS first_order_date,
    EXTRACT(YEAR FROM MIN(order_date)) AS cohort_year
  FROM `enter.tablename.view_order_grain_master`
  GROUP BY 1
),

cohort_totals AS (
  -- Step 2: Compute baseline customer count per cohort
  SELECT 
    cohort_year, 
    COUNT(DISTINCT customer_id) AS total_customers 
  FROM first_orders 
  GROUP BY 1
),

order_milestones AS (
  -- Step 3: Calculate days elapsed since acquisition for every order
  SELECT
    f.cohort_year,
    t.customer_id,
    DATE_DIFF(t.order_date, f.first_order_date, DAY) AS days_since_acquisition,
    t.profit
  FROM `enter.tablename.view_order_grain_master` t
  JOIN first_orders f ON t.customer_id = f.customer_id
)

-- Step 4: Calculate cumulative net profit per customer at milestone intervals
SELECT
  m.cohort_year,
  milestone.day_bucket AS payback_milestone_day,
  ROUND(SUM(m.profit) / c.total_customers, 2) AS cumulative_profit_per_customer
FROM order_milestones m
CROSS JOIN UNNEST([
  STRUCT(30 AS day_bucket),
  STRUCT(60 AS day_bucket),
  STRUCT(90 AS day_bucket),
  STRUCT(180 AS day_bucket),
  STRUCT(365 AS day_bucket)
]) AS milestone
JOIN cohort_totals c ON m.cohort_year = c.cohort_year
WHERE m.days_since_acquisition <= milestone.day_bucket
GROUP BY 1, 2, c.total_customers
ORDER BY m.cohort_year ASC, milestone.day_bucket ASC;
