WITH customer_cohorts AS (
  -- Step 1: Assign acquisition cohort year per customer
  SELECT
    customer_id,
    EXTRACT(YEAR FROM MIN(order_date)) AS cohort_year
  FROM `enter.tablename.view_order_grain_master`
  GROUP BY 1
),

cohort_sizes AS (
  -- Step 2: Establish base customer volume per cohort
  SELECT 
    cohort_year,
    COUNT(DISTINCT customer_id) AS original_cohort_size
  FROM customer_cohorts
  GROUP BY 1
),

yearly_activity AS (
  -- Step 3: Aggregate annual revenue and profit by cohort and performance year
  SELECT
    c.cohort_year,
    EXTRACT(YEAR FROM t.order_date) AS activity_year,
    COUNT(DISTINCT t.customer_id) AS active_customers,
    SUM(t.revenue) AS yearly_revenue,
    SUM(t.profit) AS yearly_profit
  FROM `enter.tablename.view_order_grain_master` t
  JOIN customer_cohorts c ON t.customer_id = c.customer_id
  GROUP BY 1, 2
)

-- Step 4: Final output table for Looker Studio cohort matrix
SELECT
  a.cohort_year,
  s.original_cohort_size,
  a.activity_year,
  a.active_customers,
  ROUND((a.active_customers / s.original_cohort_size) * 100, 1) AS retention_pct,
  ROUND(a.yearly_revenue, 0) AS cohort_yearly_revenue,
  ROUND(a.yearly_profit, 0) AS cohort_yearly_profit
FROM yearly_activity a
JOIN cohort_sizes s ON a.cohort_year = s.cohort_year
ORDER BY a.cohort_year ASC, a.activity_year ASC;
